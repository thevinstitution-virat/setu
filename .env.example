# Postgres (local: docker run --name setu-pg -p 55441:5432 ... — see docs/PHASE0.md)
DATABASE_URL="postgresql://setu:setu_local@localhost:55441/setu?schema=public"

# Signs session cookies and OTP hashes. Required in production (long random string).
SESSION_SECRET=
# Signs the console cookie and support links into a business. Required in production; a different random string.
PLATFORM_SESSION_SECRET=

# Tenants live at <slug>.<PLATFORM_DOMAIN>. Local dev: localhost → http://demo.localhost:3100
PLATFORM_DOMAIN=localhost
# Optional: tenant served on the bare platform domain / 127.0.0.1 (handy in dev). Leave empty in prod.
DEFAULT_TENANT_SLUG=demo

# "Continue with Google" (business sign-in pages and the console). Empty = no Google button.
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI (only this one): https://<PLATFORM_DOMAIN>/api/oauth/google/callback
# (local: http://localhost:3100/api/oauth/google/callback). Google never creates a login: it finds the one
# linked under Security, or one whose email is the Google address. Two-step sign-in still follows for staff.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1 = demo mode: skip the authenticator (two-step) step for staff and the console. Leave empty for production.
# The authenticator step is OFF by default (emailed code only). Set TWO_STEP_OFF=0 to bring it back for staff and the console.
TWO_STEP_OFF=
# Email (Resend): sign-in codes and password-reset links. Empty in development = mail is kept locally
# and the code is shown on screen; in production, empty = email sign-in and resets are refused.
RESEND_API_KEY=
EMAIL_FROM="VBiz Pro <no-reply@vpd.ceo>"

# OTP: no SMS provider yet. Without one, dev shows the code on screen; set OTP_DEV_MODE=1 to allow that on a demo server.
SMS_PROVIDER=
OTP_DEV_MODE=

# File storage: local (./storage) by default; s3 for any S3-compatible bucket (R2, MinIO, AWS).
STORAGE_DRIVER=local
STORAGE_DIR=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Background jobs run in a separate process: npm run worker. JOBS_DISABLED=1 skips enqueueing (CI).
JOBS_DISABLED=

# Error reports to GlitchTip (Sentry-compatible). SENTRY_DSN = project for server/worker errors;
# NEXT_PUBLIC_SENTRY_DSN = project for browser errors (a build-time value). Empty = off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Error and job-failure alerts to Telegram (optional). APP_ENV labels the alert (prod / staging).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_ENV=

# Optional: shows a WhatsApp CTA on the landing page's demo section when set.
# Digits only, with country code, no + or spaces (e.g. 919999999999).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Phase 7 messages. Without a provider, messages are kept in the log as LOGGED (nothing is sent).
# Web push: make a key pair with `npx web-push generate-vapid-keys`. VAPID_SUBJECT is mailto:you@yourdomain or your site URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# WhatsApp Business (Meta Cloud API). Each event's template name is set under Admin → Wording, and must be approved by Meta.
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0
# Orders shops send to that number (Phase 13): Meta webhook: /api/platform/webhooks/whatsapp on the platform address.
# WHATSAPP_VERIFY_TOKEN is any string you also type into Meta; WHATSAPP_APP_SECRET is the Meta app secret (signs each call). Both empty = webhook off.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Links inside SMS / WhatsApp are built as <scheme>://<slug>.<PLATFORM_DOMAIN>[:port]. Local dev: http and 3100.
PUBLIC_SCHEME=
PUBLIC_PORT=

# Phase 8. Encrypts the secrets a business saves (gateway key secret, webhook secrets): 32 bytes as 64 hex characters
# (e.g. `openssl rand -hex 32`). Required in production; keep it safe — changing it makes saved secrets unreadable.
SECRETS_KEY=
# Practice gateway (pays links with a button) is dev-only; set to 1 to allow it on a demo server.
ALLOW_GATEWAY_SIMULATOR=
# E-invoice test mode (fake IRNs) outside development: demo copies only.
ALLOW_EINVOICE_SANDBOX=
# Maps: google (Geocoding + Directions APIs enabled on the key) or empty for straight-line estimates.
MAPS_PROVIDER=
GOOGLE_MAPS_API_KEY=
# Outbound webhooks refuse private / local addresses; set to 1 in dev to test against a local server.
ALLOW_PRIVATE_WEBHOOKS=

# Phase 9 — our own GST invoices to businesses. Leave PLATFORM_GSTIN empty until registered: invoices then carry no GST.
PLATFORM_LEGAL_NAME=
PLATFORM_GSTIN=
PLATFORM_ADDRESS=
# Grievance officer shown on /legal/privacy (DPDP Act): an email or phone.
GRIEVANCE_CONTACT=
# Two-digit GST state code of our registration (e.g. 27 Maharashtra); decides CGST+SGST vs IGST.
PLATFORM_STATE_CODE=
# Service code on our invoices (default 997331).
PLATFORM_SAC=
# Our own Razorpay account for subscription payments (pay links on our invoices). Not a business's account.
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
# Webhook from our account → https://platform.<PLATFORM_DOMAIN>/api/platform/webhooks/razorpay (event payment_link.paid).
PLATFORM_RAZORPAY_WEBHOOK_SECRET=
# Custom domains: how certificates are made once a domain is verified.
#   caddy   — Caddy on-demand TLS asks GET /api/platform/tls/ask?domain=<host> (nothing else to set)
#   coolify — the domain is added to the app in Coolify, which gets the certificate
#   empty   — verified only; add the domain to the proxy by hand
TLS_PROVIDER=
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_APP_UUID=
# Android package names for branded builds: <prefix>.<slug> (default in.sellerssetu.app).
ANDROID_APP_ID_PREFIX=
# AI (Phase 12, catalogue assist). Empty or none = built-in rules only.
#   anthropic — needs ANTHROPIC_API_KEY; fake — tests only
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Model for AI calls (default claude-opus-5-5; claude-haiku-5-5 costs far less).
AI_MODEL=
# Paise per US$ for the AI cost log (default 8800).
AI_USD_PAISE=

# Security review. How many proxies sit in front of the app (1: Coolify's Traefik; 2: a CDN in front of it).
# Client addresses for rate limits and the audit log are read that many entries from the right of X-Forwarded-For.
TRUST_PROXY_HOPS=1
