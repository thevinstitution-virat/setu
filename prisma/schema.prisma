// Seller's Setu — multi-tenant distribution platform
// (retailer / sales agent / delivery agent / admin, one app, one database).
//
// Tenancy rules (see docs/ROADMAP.md §4.3 and docs/PHASE0.md):
// - Tenant and TenantDomain are platform tables (no row-level security).
// - Every other table carries "tenantId" and is protected by Postgres
//   row-level security: rows are visible only when the session setting
//   app.tenant_id matches. Use tenantDb() from src/lib/db.ts, never the raw
//   client, for tenant data.
// - "tenantId" defaults to current_setting('app.tenant_id'), so creates made
//   through tenantDb() are stamped automatically.
// - Money is stored as integer paise (Int). Never Float for money.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RETAILER
  SALES_AGENT
  DELIVERY_AGENT
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  ONLINE
  CREDIT
}

enum PaymentStatus {
  PENDING
  COLLECTED
  SETTLED
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

// ───────────────────────────── Platform tables ─────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique // subdomain: <slug>.<PLATFORM_DOMAIN>
  name      String       // display / brand name
  legalName String?
  gstin     String?
  stateCode String?      // GST state code, e.g. "27" for Maharashtra
  address   String?
  phone     String?
  status    TenantStatus @default(TRIAL)
  plan      String       @default("trial")
  /// White-label settings: { primary, accent, logoUrl, shortName, ... }
  brand     Json         @default("{}")
  /// Business rules: { orderCutoff, slots, minOrderPaise, ... }
  settings  Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  domains           TenantDomain[]
  users             User[]
  regions           Region[]
  areas             Area[]
  retailers         RetailerProfile[]
  salesAgents       SalesAgentProfile[]
  beats             Beat[]
  deliveryAgents    DeliveryAgentProfile[]
  products          Product[]
  orders            Order[]
  orderItems        OrderItem[]
  orderStatusEvents OrderStatusEvent[]
  visits            Visit[]
  attendance        Attendance[]
  deliveries        Delivery[]
  otpChallenges     OtpChallenge[]
  counters          Counter[]
  auditLogs         AuditLog[]
  ledgerAccounts    LedgerAccount[]
  journalEntries    JournalEntry[]
  ledgerLines       LedgerLine[]
  bills             Bill[]
  payments          Payment[]
  allocations       PaymentAllocation[]
  cheques           Cheque[]
  cashHandovers     CashHandover[]
}

/// Custom domains a tenant has verified (e.g. order.agencyname.in).
model TenantDomain {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host       String    @unique
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ───────────────────────────── Tenant tables ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  phone        String?
  email        String?
  loginId      String?
  passwordHash String?
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  retailerProfile      RetailerProfile?
  salesAgentProfile    SalesAgentProfile?
  deliveryAgentProfile DeliveryAgentProfile?

  orderEvents OrderStatusEvent[]
  auditLogs   AuditLog[]
  paymentsCollected Payment[]      @relation("PaymentCollectedBy")
  handoversGiven    CashHandover[] @relation("HandoverStaff")

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@unique([tenantId, loginId])
  @@index([tenantId, role])
}

model Region {
  id       String @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String
  areas    Area[]

  @@unique([tenantId, name])
}

model Area {
  id       String @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String
  regionId String
  region   Region @relation(fields: [regionId], references: [id])

  retailers RetailerProfile[]
  beats     Beat[]

  @@unique([regionId, name])
  @@index([tenantId])
}

model RetailerProfile {
  id           String             @id @default(cuid())
  tenantId     String             @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id])
  outletName   String
  shopNumber   String
  complexName  String
  pinCode      String
  areaId       String
  area         Area               @relation(fields: [areaId], references: [id])
  salesAgentId String?
  salesAgent   SalesAgentProfile? @relation(fields: [salesAgentId], references: [id])
  /// null = use the tenant default (settings.money.defaultPaymentMode)
  paymentMode  PaymentMode?
  /// Credit limit in paise. null = tenant default; 0 = no credit.
  creditLimit  Int?
  /// Days a bill may stay unpaid before it is overdue. null = tenant default.
  creditDays   Int?
  createdAt    DateTime           @default(now())

  orders   Order[]
  visits   Visit[]
  bills    Bill[]
  payments Payment[]
  accounts LedgerAccount[]

  @@index([tenantId, areaId])
  @@index([tenantId, salesAgentId])
}

model SalesAgentProfile {
  id       String @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])

  beats      Beat[]
  retailers  RetailerProfile[]
  visits     Visit[]
  attendance Attendance[]

  @@index([tenantId])
}

model Beat {
  id           String            @id @default(cuid())
  tenantId     String            @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  name         String
  salesAgentId String
  salesAgent   SalesAgentProfile @relation(fields: [salesAgentId], references: [id])
  areaId       String
  area         Area              @relation(fields: [areaId], references: [id])

  @@index([tenantId])
}

model DeliveryAgentProfile {
  id       String @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])

  deliveries Delivery[]

  @@index([tenantId])
}

model Product {
  id           String  @id @default(cuid())
  tenantId     String  @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  name         String
  sku          String
  category     String
  unit         String
  /// Selling rate before GST, in paise.
  price        Int
  /// Maximum retail price, in paise.
  mrp          Int
  gstRate      Float   @default(0)
  specialOffer String?
  imageUrl     String?
  active       Boolean @default(true)

  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, active])
}

model Order {
  id          String          @id @default(cuid())
  tenantId    String          @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  orderNumber String
  retailerId  String
  retailer    RetailerProfile @relation(fields: [retailerId], references: [id])
  placedById  String?
  status      OrderStatus     @default(PLACED)
  /// Amounts in paise.
  subtotal    Int             @default(0)
  gstAmount   Int             @default(0)
  totalAmount Int
  notes       String?
  /// Placed over the credit limit or with overdue bills: needs approval before it moves on.
  creditHold       Boolean   @default(false)
  creditHoldReason String?
  creditApprovedBy String?
  creditApprovedAt DateTime?
  /// Prepaid: amount reserved from the wallet when the order was placed (paise).
  walletHold  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items        OrderItem[]
  bill         Bill?
  statusEvents OrderStatusEvent[]
  delivery     Delivery?
  visit        Visit?

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, retailerId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  tenantId  String  @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  /// Rate per unit before GST, in paise, frozen at order time.
  price     Int
  gstRate   Float   @default(0)

  @@index([tenantId, orderId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  tenantId  String      @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id])
  createdAt DateTime    @default(now())

  @@index([tenantId, orderId])
}

model Visit {
  id           String            @id @default(cuid())
  tenantId     String            @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  salesAgentId String
  salesAgent   SalesAgentProfile @relation(fields: [salesAgentId], references: [id])
  retailerId   String
  retailer     RetailerProfile   @relation(fields: [retailerId], references: [id])
  checkInAt    DateTime          @default(now())
  checkInLat   Float?
  checkInLng   Float?
  checkOutAt   DateTime?
  notes        String?
  orderId      String?           @unique
  order        Order?            @relation(fields: [orderId], references: [id])

  @@index([tenantId, salesAgentId, checkInAt])
}

model Attendance {
  id           String            @id @default(cuid())
  tenantId     String            @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  salesAgentId String
  salesAgent   SalesAgentProfile @relation(fields: [salesAgentId], references: [id])
  date         String
  checkInAt    DateTime?
  checkInLat   Float?
  checkInLng   Float?
  checkOutAt   DateTime?

  @@unique([salesAgentId, date])
  @@index([tenantId])
}

model Delivery {
  id               String               @id @default(cuid())
  tenantId         String               @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant           Tenant               @relation(fields: [tenantId], references: [id])
  orderId          String               @unique
  order            Order                @relation(fields: [orderId], references: [id])
  deliveryAgentId  String
  deliveryAgent    DeliveryAgentProfile @relation(fields: [deliveryAgentId], references: [id])
  assignedAt       DateTime             @default(now())
  deliveredAt      DateTime?
  lat              Float?
  lng              Float?
  /// Storage key (t/<tenantId>/pod-photo/...), served via /api/files/<key>.
  podPhotoUrl      String?
  /// Storage key of the signature image.
  podSignatureData String?
  paymentMethod    PaymentMethod        @default(CASH)
  paymentStatus    PaymentStatus        @default(PENDING)
  /// Cash collected on delivery, in paise.
  codAmount        Int                  @default(0)

  @@index([tenantId, deliveryAgentId])
}

/// One-time passwords for phone login. Stored hashed; survives restarts and
/// works across several app instances.
model OtpChallenge {
  id         String    @id @default(cuid())
  tenantId   String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, phone, createdAt])
}

/// Gap-free per-tenant sequences (order numbers, later invoice series per FY).
model Counter {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  key      String
  value    Int    @default(0)

  @@id([tenantId, key])
}

/// Who changed what. Append-only.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String   // e.g. "order.status", "product.update", "user.create"
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
}

// ───────────────────────────── Money (Phase 1) ─────────────────────────────
//
// Double-entry ledger. Every money event is one JournalEntry whose lines sum
// to zero (enforced by a deferred database trigger). Amounts are paise,
// debit positive, credit negative. Entries and lines are append-only (RLS
// allows only SELECT and INSERT); mistakes are fixed by reversal entries.
//
// Bills (what a retailer owes, oldest first) and Payments (what they paid)
// with Allocations between them give ageing and "which bill is open". The
// ledger is the source of truth for balances; tests check both agree.

enum PaymentMode {
  PREPAID
  POSTPAID
}

enum AccountType {
  RECEIVABLE      // per retailer: what they owe us
  WALLET          // per retailer: prepaid money we hold (credit balance)
  WALLET_HOLD     // per retailer: wallet money reserved for open orders
  STAFF_CASH      // per staff member: cash in hand not yet handed over
  OFFICE_CASH
  BANK
  UPI_CLEARING
  CHEQUES_IN_HAND
  SALES
  GST_OUTPUT
  OPENING_EQUITY
  DISCOUNT
  PENALTY_INCOME
  CASH_SHORTAGE
}

enum EntryKind {
  SALE
  OPENING
  PAYMENT
  WALLET_RECHARGE
  WALLET_HOLD
  WALLET_RELEASE
  WALLET_SETTLE
  CHEQUE_CLEAR
  CHEQUE_BOUNCE
  PENALTY
  DEBIT_NOTE
  CREDIT_NOTE
  HANDOVER
  SHORTAGE_WRITEOFF
  REVERSAL
}

enum PayMethod {
  CASH
  UPI
  CHEQUE
  BANK
  WALLET
  CREDIT_NOTE
}

enum PayPurpose {
  DUES
  WALLET
}

enum PaymentState {
  PENDING_VERIFICATION
  CONFIRMED
  REJECTED
  REVERSED
}

enum ChequeStatus {
  RECEIVED
  DEPOSITED
  CLEARED
  BOUNCED
}

enum BillKind {
  ORDER
  OPENING
  PENALTY
  DEBIT_NOTE
}

model LedgerAccount {
  id         String           @id @default(cuid())
  tenantId   String           @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  type       AccountType
  /// e.g. "RECEIVABLE:<retailerId>", "STAFF_CASH:<userId>", "BANK"
  code       String
  name       String
  retailerId String?
  retailer   RetailerProfile? @relation(fields: [retailerId], references: [id])
  userId     String?
  createdAt  DateTime         @default(now())

  lines LedgerLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

model JournalEntry {
  id          String        @id @default(cuid())
  tenantId    String        @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  kind        EntryKind
  memo        String?
  occurredAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  createdById String?
  retailerId  String?
  orderId     String?
  paymentId   String?
  /// Set on a REVERSAL entry: the entry it cancels (at most one reversal each).
  reversesId  String?       @unique
  reverses    JournalEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy  JournalEntry? @relation("Reversal")

  lines LedgerLine[]

  @@index([tenantId, retailerId, occurredAt])
  @@index([tenantId, kind, occurredAt])
}

model LedgerLine {
  id        String        @id @default(cuid())
  tenantId  String        @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  entryId   String
  entry     JournalEntry  @relation(fields: [entryId], references: [id])
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  /// Paise. Debit positive, credit negative.
  amount    Int
  createdAt DateTime      @default(now())

  @@index([tenantId, accountId])
  @@index([entryId])
}

model Bill {
  id         String              @id @default(cuid())
  tenantId   String              @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  retailerId String
  retailer   RetailerProfile     @relation(fields: [retailerId], references: [id])
  kind       BillKind
  number     String
  orderId    String?             @unique
  order      Order?              @relation(fields: [orderId], references: [id])
  date       DateTime
  dueDate    DateTime
  /// Paise owed by this bill.
  amount     Int
  /// Paise allocated from payments so far (maintained by allocateRetailer).
  paid       Int                 @default(0)
  settled    Boolean             @default(false)
  note       String?
  entryId    String?
  createdAt  DateTime            @default(now())

  allocations PaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, retailerId, settled, date])
}

model Payment {
  id            String              @id @default(cuid())
  tenantId      String              @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  number        String
  retailerId    String
  retailer      RetailerProfile     @relation(fields: [retailerId], references: [id])
  purpose       PayPurpose          @default(DUES)
  method        PayMethod
  state         PaymentState
  /// Paise.
  amount        Int
  /// UPI reference (UTR), bank reference or cheque number.
  reference     String?
  proofKey      String?
  note          String?
  /// Collected against this order at delivery (allocated to its bill first).
  orderId       String?
  collectedById String?
  collectedBy   User?               @relation("PaymentCollectedBy", fields: [collectedById], references: [id])
  collectedAt   DateTime            @default(now())
  verifiedById  String?
  verifiedAt    DateTime?
  rejectReason  String?
  entryId       String?
  /// Paise of this payment already allocated to bills.
  allocated     Int                 @default(0)
  createdAt     DateTime            @default(now())

  allocations PaymentAllocation[]
  cheque      Cheque?

  @@unique([tenantId, number])
  @@index([tenantId, retailerId, collectedAt])
  @@index([tenantId, state])
  @@index([tenantId, collectedById, collectedAt])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([tenantId, billId])
  @@index([tenantId, paymentId])
}

model Cheque {
  id           String       @id @default(cuid())
  tenantId     String       @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  paymentId    String       @unique
  payment      Payment      @relation(fields: [paymentId], references: [id])
  number       String
  bank         String
  chequeDate   DateTime
  status       ChequeStatus @default(RECEIVED)
  depositedAt  DateTime?
  clearedAt    DateTime?
  bouncedAt    DateTime?
  bounceReason String?
  createdAt    DateTime     @default(now())

  @@index([tenantId, status])
}

model CashHandover {
  id           String   @id @default(cuid())
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  staffUserId  String
  staff        User     @relation("HandoverStaff", fields: [staffUserId], references: [id])
  receivedById String
  /// Cash the staff member should have had (paise).
  expected     Int
  /// Cash actually counted and received (paise).
  counted      Int
  /// expected − counted; positive = short.
  variance     Int
  note         String?
  entryId      String?
  createdAt    DateTime @default(now())

  @@index([tenantId, staffUserId, createdAt])
}
